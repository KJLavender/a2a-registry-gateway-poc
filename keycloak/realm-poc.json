{
  "realm": "poc",
  "enabled": true,
  "adminPermissionsEnabled": true,
  "accessTokenLifespan": 28800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 32400,
  "groups": [
    {
      "name": "dept-analytics"
    },
    {
      "name": "dept-finance"
