  "clientScopes": [
    {
      "name": "poc-claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "delegation:client",
      "protocol": "openid-connect",
      "description": "OpenID Connect scope for agent/client token exchange delegation",
      "attributes": {
        "include.in.token.scope": "true",
        "parameterized.scope.type": "client-delegation",
        "display.on.consent.screen": "true",
        "always.display.consent": "true",
        "is.parameterized.scope": "true",
        "consent.screen.text": "${clientDelegationScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "client may_act client_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-parameterized-scope-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "may_act.client_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client delegation audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-parameterized-scope-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client may_act sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-parameterized-scope-client-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "may_act.sub",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
